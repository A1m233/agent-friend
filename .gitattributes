# Keep the Tauri manifest stable across Windows/macOS dev runs.
frontend/src-tauri/Cargo.toml text eol=lf

# Shell scripts must stay LF even when Windows core.autocrlf is enabled.
scripts/dev/run.sh text eol=lf
scripts/_lib/python312.sh text eol=lf
scripts/build-storage/run.sh text eol=lf
scripts/package/run.sh text eol=lf
scripts/rust-check/run.sh text eol=lf
scripts/frontend/dev.sh text eol=lf
scripts/session-memory/run.sh text eol=lf

# Checksummed source patches must keep byte-identical LF content on Windows.
scripts/_lib/xiaohongshu_connector/windows-disable-leakless.patch text eol=lf

# Builtin Skill manifests and snapshots use byte-exact SHA-256 digests.
agent/src/agent/skills/builtin_assets/** text eol=lf
# Preserve upstream PNG bytes instead of applying the text rule above.
agent/src/agent/skills/builtin_assets/pdf/assets/*.png -text
agent/src/agent/skills/builtin_assets/screenshot/assets/*.png -text
agent/src/agent/skills/builtin_assets/doc/assets/*.png -text
agent/src/agent/skills/builtin_assets/spreadsheet/assets/*.png -text
