{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "agent-friend",
  "version": "0.1.0",
  "identifier": "com.agentfriend.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "url": "pet.html",
        "title": "agent-friend",
        "width": 360,
        "height": 420,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "chat",
        "url": "chat.html",
        "title": "agent-friend · 对话",
        "width": 420,
        "height": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
