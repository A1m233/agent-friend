{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "agent-friend",
  "mainBinaryName": "agent-friend",
  "version": "0.4.0",
  "identifier": "com.agentfriend.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "url": "pet.html",
        "title": "agent-friend",
        "width": 240,
        "height": 320,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "bubble",
        "url": "bubble.html",
        "title": "agent-friend-bubble",
        "width": 280,
        "height": 96,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "fullscreen": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "chat",
        "url": "chat.html",
        "title": "agent-friend",
        "width": 1040,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": false,
        "fullscreen": false
      },
      {
        "label": "voice-call",
        "url": "voice-call.html",
        "title": "agent-friend · 语音通话",
        "width": 360,
        "height": 520,
        "resizable": false,
        "visible": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$DATA/agent-friend/avatar-models/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../public/live2d-models/hiyori/": "avatar-seed/live2d/hiyori",
      "../public/spine-models/ark-models/": "avatar-seed/spine/ark-models"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
