diff --git a/headless_browser/headless_browser.go b/headless_browser/headless_browser.go
--- a/headless_browser/headless_browser.go
+++ b/headless_browser/headless_browser.go
@@ -182,7 +182,10 @@ func New(options ...Option) *Browser {
 		option(cfg)
 	}
 
-	l := launcher.New().
+	// Windows Defender can quarantine Rod's embedded leakless helper. Browser
+	// callers close explicitly, and agent-friend owns the connector process.
+	l := launcher.New().
+		Leakless(false).
 		Headless(cfg.Headless).
 		Set("--no-sandbox")
 
